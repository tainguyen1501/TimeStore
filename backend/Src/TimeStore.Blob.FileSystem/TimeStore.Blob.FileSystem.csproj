        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\TimeStore.Primitives\TimeStore.Primitives.csproj" />
        <ProjectReference Include="..\TimeStore.Domain\TimeStore.Domain.csproj" />
    </ItemGroup>

</Project>
