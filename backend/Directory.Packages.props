<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!-- One version per package for the whole solution. Add a package here when a project first needs it.
         Every production package must work under Native AOT (see .claude/rules/aot.md). -->
    <ItemGroup>
        <!-- Cryptography: CRC32/CRC32C/CRC64NVME (Crc32ParameterSet.Crc32C, Crc64ParameterSet.Nvme since 11.0) -->
        <PackageVersion Include="System.IO.Hashing" Version="11.0.0" />

        <!-- Cache (Infra, behind ICacheService). Not HybridCache: 11.0.0 fails Native AOT publish (IL2026). -->
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />

        <!-- Server, admin port: OpenAPI document (runtime, AOT-safe with source-generated JSON) and the embedded UI
             (ManifestEmbeddedFileProvider keeps directory paths). -->
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="11.0.0" />

        <!-- Metadata provider -->
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />

        <!-- Tests. AWSSDK.S3: the real client as the reference for signatures (test-only, used as a client). -->
        <PackageVersion Include="AWSSDK.S3" Version="4.1.0.1" />
        <!-- Benchmarks only (backend/Benchmarks): micro benchmarks of the hot path, run in process. -->
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    </ItemGroup>

</Project>
